// OpenJDK Mobile (embedded JVM) — base configuration for the CoreJ2 app target.
//
// The device-only link flags live in OpenJDKMobile.link.xcconfig, generated by
// scripts/openjdk-mobile/generate-xcode-link-xcconfig.sh after
// scripts/openjdk-mobile/build-all.sh stages libjvm.a. The include is optional
// so simulator builds work before the JVM is built.

#include? "OpenJDKMobile.link.xcconfig"

// Vendored JNI headers (from the pinned openjdk/mobile commit) so the C
// gateway compiles without a host JDK installed.
HEADER_SEARCH_PATHS = $(inherited) $(SRCROOT)/ThirdParty/OpenJDKMobile/jni-include
